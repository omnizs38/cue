#pragma code_page(65001)
#include <windows.h>
#include "../src/core/version.h"
1 ICON "../res/cue.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "setup.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION CUE_VERSION_MAJOR,CUE_VERSION_MINOR,CUE_VERSION_PATCH,0
PRODUCTVERSION CUE_VERSION_MAJOR,CUE_VERSION_MINOR,CUE_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", CUE_DISTRIBUTOR
      VALUE "FileDescription", "Instalador do Cue"
      VALUE "ProductName", CUE_PRODUCT_NAME
      VALUE "InternalName", "Cue-Setup"
      VALUE "OriginalFilename", "Cue-Setup.exe"
      VALUE "FileVersion", CUE_VERSION
      VALUE "ProductVersion", CUE_VERSION
    END
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", CUE_DISTRIBUTOR
      VALUE "FileDescription", "Cue installer"
      VALUE "ProductName", CUE_PRODUCT_NAME
      VALUE "InternalName", "Cue-Setup"
      VALUE "OriginalFilename", "Cue-Setup.exe"
      VALUE "FileVersion", CUE_VERSION
      VALUE "ProductVersion", CUE_VERSION
    END
    BLOCK "0C0A04B0"
    BEGIN
      VALUE "CompanyName", CUE_DISTRIBUTOR
      VALUE "FileDescription", "Instalador de Cue"
      VALUE "ProductName", CUE_PRODUCT_NAME
      VALUE "InternalName", "Cue-Setup"
      VALUE "OriginalFilename", "Cue-Setup.exe"
      VALUE "FileVersion", CUE_VERSION
      VALUE "ProductVersion", CUE_VERSION
    END
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", CUE_DISTRIBUTOR
      VALUE "FileDescription", "Programme d'installation de Cue"
      VALUE "ProductName", CUE_PRODUCT_NAME
      VALUE "InternalName", "Cue-Setup"
      VALUE "OriginalFilename", "Cue-Setup.exe"
      VALUE "FileVersion", CUE_VERSION
      VALUE "ProductVersion", CUE_VERSION
    END
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName", CUE_DISTRIBUTOR
      VALUE "FileDescription", "Cue 安装程序"
      VALUE "ProductName", CUE_PRODUCT_NAME
      VALUE "InternalName", "Cue-Setup"
      VALUE "OriginalFilename", "Cue-Setup.exe"
      VALUE "FileVersion", CUE_VERSION
      VALUE "ProductVersion", CUE_VERSION
    END
    BLOCK "041904B0"
    BEGIN
      VALUE "CompanyName", CUE_DISTRIBUTOR
      VALUE "FileDescription", "Установщик Cue"
      VALUE "ProductName", CUE_PRODUCT_NAME
      VALUE "FileVersion", CUE_VERSION
      VALUE "ProductVersion", CUE_VERSION
    END
    BLOCK "040704B0"
    BEGIN
      VALUE "CompanyName", CUE_DISTRIBUTOR
      VALUE "FileDescription", "Cue-Installationsprogramm"
      VALUE "ProductName", CUE_PRODUCT_NAME
      VALUE "FileVersion", CUE_VERSION
      VALUE "ProductVersion", CUE_VERSION
    END
    BLOCK "041104B0"
    BEGIN
      VALUE "CompanyName", CUE_DISTRIBUTOR
      VALUE "FileDescription", "Cue インストーラー"
      VALUE "ProductName", CUE_PRODUCT_NAME
      VALUE "FileVersion", CUE_VERSION
      VALUE "ProductVersion", CUE_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    // the description in each interface language Cue speaks (Explorer picks the one it shows)
    VALUE "Translation", 0x416, 1200, 0x409, 1200, 0xC0A, 1200, 0x40C, 1200, 0x804, 1200, 0x419, 1200, 0x407, 1200, 0x411, 1200
  END
END
