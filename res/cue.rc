#include <windows.h>
#include "../src/core/version.h"
1 ICON "cue.ico"
// music files: the same tile with a pixel note (video files carry the icon above)
2 ICON "cue-audio.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "cue.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION CUE_VERSION_MAJOR,CUE_VERSION_MINOR,CUE_VERSION_PATCH,0
PRODUCTVERSION CUE_VERSION_MAJOR,CUE_VERSION_MINOR,CUE_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", CUE_DISTRIBUTOR
      VALUE "FileDescription", "Cue"
      VALUE "ProductName", CUE_PRODUCT_NAME
      VALUE "InternalName", "Cue"
      VALUE "OriginalFilename", "Cue.exe"
      VALUE "FileVersion", CUE_VERSION
      VALUE "ProductVersion", CUE_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x416, 1200
  END
END
